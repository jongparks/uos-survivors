# Local Vite. On Vercel, set this to the Render public HTTPS/WSS URL, then redeploy.
# This is public build-time configuration, never a secret key.
VITE_GAME_SERVER_URL=http://localhost:2567

# Render: NODE_ENV=production; PORT is supplied by the platform.
# Local game server:
PORT=2567
NODE_ENV=development

